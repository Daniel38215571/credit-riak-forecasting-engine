import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.metrics import brier_score_loss, roc_auc_score, precision_recall_curve
from sklearn.calibration import CalibratedClassifierCV
from xgboost import XGBClassifier
import matplotlib.pyplot as plt

# 1. Load the dataset (Mocking the Home Credit dataset structure)
# In a real scenario, this would be the output of the SQL pipeline
# df = pd.read_sql("SELECT * FROM features", con=engine)
np.random.seed(42)
n_samples = 10000
df = pd.DataFrame({
    'rolling_6m_payment_ratio': np.random.rand(n_samples),
    'total_late_payments': np.random.randint(0, 10, n_samples),
    'worst_risk_decile': np.random.randint(1, 11, n_samples),
    'target_default': np.random.choice([0, 1], n_samples, p=[0.9, 0.1]) # 10% default rate
})

X = df.drop('target_default', axis=1)
y = df['target_default']

# 2. Time-based split (Senior-level practice: never random split for credit risk)
# Assume the first 80% of data is historical, last 20% is future
split_idx = int(len(df) * 0.8)
X_train, X_test = X.iloc[:split_idx], X.iloc[split_idx:]
y_train, y_test = y.iloc[:split_idx], y.iloc[split_idx:]

# 3. Train the base model with scale_pos_weight to handle class imbalance
base_model = XGBClassifier(
    n_estimators=100,
    max_depth=4,
    learning_rate=0.05,
    scale_pos_weight=(len(y_train) - sum(y_train)) / sum(y_train),
    random_state=42
)
base_model.fit(X_train, y_train)

# 4. Probability Calibration (Senior-level practice: raw XGBoost probabilities are often overconfident)
calibrated_model = CalibratedClassifierCV(base_model, method='isotonic', cv=3)
calibrated_model.fit(X_train, y_train)

# 5. Cost-Sensitive Thresholding (The "Decision Science" part)
# Assume: Cost of False Negative (Approving a defaulter) = $10,000
# Assume: Cost of False Positive (Rejecting a good customer) = $1,000
cost_fn = 10000
cost_fp = 1000

y_probs = calibrated_model.predict_proba(X_test)[:, 1]
thresholds = np.linspace(0.01, 0.99, 100)
expected_costs = []

for t in thresholds:
    y_pred = (y_probs >= t).astype(int)
    fn = ((y_test == 1) & (y_pred == 0)).sum()
    fp = ((y_test == 0) & (y_pred == 1)).sum()
    total_cost = (fn * cost_fn) + (fp * cost_fp)
    expected_costs.append(total_cost)

# 6. Find the optimal threshold
optimal_idx = np.argmin(expected_costs)
optimal_threshold = thresholds[optimal_idx]
min_cost = expected_costs[optimal_idx]

print(f"Optimal Threshold: {optimal_threshold:.2f}")
print(f"Minimum Expected Cost: ${min_cost:,.2f}")

# 7. Evaluation metrics (Senior-level practice: PR-AUC and Brier Score, not just Accuracy)
auc_roc = roc_auc_score(y_test, y_probs)
brier = brier_score_loss(y_test, y_probs)
print(f"ROC-AUC: {auc_roc:.4f}")
print(f"Brier Score: {brier:.4f}")

# 8. The Decision Science Layer: Business Value Simulation
# We simulate what happens to the bank's profit at different approval thresholds.
# Assume: 
# - Good customer generates $2,000 in profit over the life of the loan.
# - Good customer defaulting costs $10,000.
# - Bad customer rejected costs $0.

profit_per_good_customer = 2000
cost_per_bad_customer = 10000

results = []
# Test thresholds from 0.1 (approve almost everyone) to 0.9 (reject almost everyone)
test_thresholds = np.linspace(0.1, 0.9, 9)

for t in test_thresholds:
    y_pred = (y_probs >= t).astype(int)
    
    # True Positives (Rejected defaulters) -> Saved $10k, but lost $2k profit
    # False Positives (Rejected good customers) -> Lost $2k profit
    # True Negatives (Approved good customers) -> Made $2k profit
    # False Negatives (Approved defaulters) -> Lost $10k
    
    rejected_good = ((y_test == 0) & (y_pred == 1)).sum()
    approved_good = ((y_test == 0) & (y_pred == 0)).sum()
    approved_bad = ((y_test == 1) & (y_pred == 0)).sum()
    
    total_profit = (approved_good * profit_per_good_customer) - (approved_bad * cost_per_bad_customer)
    
    results.append({
        "Threshold": round(t, 2),
        "Approved Customers": approved_good,
        "Rejected Good Customers": rejected_good,
        "Approved Defaulters (Bad)": approved_bad,
        "Expected Profit": total_profit
    })

simulation_df = pd.DataFrame(results)
print("\n--- Business Value Simulation (Counterfactual Analysis) ---")
print(simulation_df.to_string(index=False))

# Find the threshold that maximizes profit
best_policy = simulation_df.loc[simulation_df['Expected Profit'].idxmax()]
print(f"\nOptimal Business Policy: Set threshold to {best_policy['Threshold']}")
print(f"Maximized Expected Profit: ${best_policy['Expected Profit']:,.2f}")
