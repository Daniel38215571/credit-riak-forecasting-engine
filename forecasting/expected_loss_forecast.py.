import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.holtwinters import ExponentialSmoothing
from sklearn.metrics import mean_absolute_error
import warnings
warnings.filterwarnings('ignore')

# 1. Mock the Expected Loss data
np.random.seed(42)
dates = pd.date_range(start='2024-01-01', periods=48, freq='M') # 4 years of data
trend = np.linspace(100000, 150000, 48)
seasonality = np.sin(np.linspace(0, 4 * np.pi, 48)) * 20000
noise = np.random.normal(0, 5000, 48)
expected_loss = trend + seasonality + noise

df = pd.DataFrame({'date': dates, 'expected_loss': expected_loss})
df.set_index('date', inplace=True)

# 2. ROLLING-ORIGIN BACKTESTING (The Senior-level Part)
# We simulate forecasting 6 months ahead, 4 different times in history.
# This prevents data leakage and proves the model works in production.
print("--- ROLLING-ORIGIN BACKTESTING ---")
train_window = 24 # 2 years of training data
forecast_horizon = 6 # predict 6 months out

backtest_mae = []

for i in range(len(df) - train_window - forecast_horizon + 1):
    train_data = df['expected_loss'].iloc[i : i + train_window]
    test_data = df['expected_loss'].iloc[i + train_window : i + train_window + forecast_horizon]
    
    # Fit model
    model = ExponentialSmoothing(train_data, trend='add', seasonal='add', seasonal_periods=12).fit()
    forecast = model.forecast(forecast_horizon)
    
    # Evaluate
    mae = mean_absolute_error(test_data, forecast)
    backtest_mae.append(mae)
    print(f"Fold {i+1}: Trained up to {train_data.index[-1].strftime('%Y-%m')}, MAE: ${mae:,.2f}")

print(f"\nAverage MAE across backtests: ${np.mean(backtest_mae):,.2f}")

# 3. THE ASYMMETRIC COST FUNCTION (The Decision Science Part)
# In financial forecasting, under-predicting loss is worse than over-predicting it.
# If we predict low (underestimate loss), we don't hold enough capital -> Catastrophic.
# If we predict high (overestimate loss), we hold too much capital -> Opportunity cost.
cost_underpredict = 100 # Cost of being $1 short
cost_overpredict = 10   # Cost of holding $1 extra

final_model = ExponentialSmoothing(df['expected_loss'], trend='add', seasonal='add', seasonal_periods=12).fit()
base_forecast = final_model.forecast(6)

# We adjust the forecast to minimize the asymmetric cost
# The optimal adjustment is derived from the ratio of costs
adjustment = (cost_underpredict - cost_overpredict) / (cost_underpredict + cost_overpredict)

# For a 90% confidence bound, we use a Z-score of 1.28
residual_std = np.std(final_model.resid)
z_score = 1.28 # 90% one-sided confidence

# Adjusted forecast (pushing it up to be safe)
safe_forecast = base_forecast + (z_score * residual_std * adjustment)

# 4. Build the final DataFrame for the business
forecast_df = pd.DataFrame({
    'Point_Forecast': base_forecast,
    'Safe_Capital_Reserve': safe_forecast,
    'Upper_Bound_95': base_forecast + (1.96 * residual_std)
})

print("\n--- FINAL CAPITAL RESERVE FORECAST ---")
print(forecast_df)

# 5. Plotting
plt.figure(figsize=(12, 6))
plt.plot(df.index, df['expected_loss'], label='Historical Loss', color='blue')
plt.plot(forecast_df.index, forecast_df['Point_Forecast'], label='Point Forecast', color='orange', linestyle='--')
plt.plot(forecast_df.index, forecast_df['Safe_Capital_Reserve'], label='Safe Capital Reserve (Cost-Adjusted)', color='red', linewidth=2)
plt.fill_between(forecast_df.index, forecast_df['Point_Forecast'], forecast_df['Upper_Bound_95'], color='red', alpha=0.1)
plt.title('Expected Loss Forecast with Asymmetric Cost Adjustment')
plt.ylabel('Expected Loss ($)')
plt.legend()
plt.grid(True)
plt.show()
