// rust-engine/src/main.rs
// High-performance Credit Risk Scoring Engine

use std::io::{self, Read};

#[derive(Debug)]
struct CreditFeatures {
    rolling_6m_payment_ratio: f64,
    total_late_payments: f64,
    worst_risk_decile: f64,
}

// A mock scoring function that mimics the XGBoost logic
// In production, this would load the serialized model weights
fn calculate_default_probability(features: &CreditFeatures) -> f64 {
    let mut score = 0.0;
    
    // Penalize low payment ratios
    if features.rolling_6m_payment_ratio < 0.8 {
        score += 0.3;
    } else if features.rolling_6m_payment_ratio < 0.95 {
        score += 0.1;
    }

    // Penalize frequent late payments
    score += features.total_late_payments * 0.05;

    // Penalize high-risk deciles
    if features.worst_risk_decile > 7.0 {
        score += 0.2;
    }

    // Sigmoid function to map to 0-1 probability
    let probability = 1.0 / (1.0 + (-10.0 * (score - 0.5)).exp());
    probability.clamp(0.0, 1.0)
}

fn main() {
    // Read the mock JSON payload from stdin
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();

    // In a real scenario, we would use serde_json to parse this.
    // For simplicity in this demo, we mock the input features.
    // This simulates a payload coming from the FastAPI gateway.
    let features = CreditFeatures {
        rolling_6m_payment_ratio: 0.75, // High risk
        total_late_payments: 3.0,
        worst_risk_decile: 9.0,
    };

    // 1. Calculate the raw probability
    let pd = calculate_default_probability(&features);
    println!("Raw Default Probability: {:.4}", pd);

    // 2. Apply Cost-Sensitive Thresholding (from the Python model)
    // Cost of False Negative (Approving a defaulter): $10,000
    // Cost of False Positive (Rejecting a good customer): $1,000
    // Optimal threshold derived from the Python cost curve: 0.45
    let optimal_threshold = 0.45;

    let decision = if pd >= optimal_threshold {
        "REJECT"
    } else {
        "APPROVE"
    };

    println!("Decision: {}", decision);
}
