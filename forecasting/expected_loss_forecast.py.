import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from statsmodels.tsa.holtwinters import ExponentialSmoothing
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

# 1. Mock the Expected Loss data (Aggregated monthly from the Credit Risk Model)
# In a real pipeline, this would be: SELECT month, SUM(pd * lgd * ead) FROM predictions GROUP BY 1
np.random.seed(42)
dates = pd.date_range(start='2024-01-01', periods=36, freq='M')
# Create a trend + seasonality + noise
trend = np.linspace(100000, 150000, 36)
seasonality = np.sin(np.linspace(0, 3 * np.pi, 36)) * 20000
noise = np.random.normal(0, 5000, 36)
expected_loss = trend + seasonality + noise

df = pd.DataFrame({'date': dates, 'expected_loss': expected_loss})
df.set_index('date', inplace=True)

# 2. Train the Forecasting Model (Holt-Winters Exponential Smoothing)
# This handles trend and seasonality natively
model = ExponentialSmoothing(
    df['expected_loss'], 
    trend='add', 
    seasonal='add', 
    seasonal_periods=12
).fit()

# 3. Forecast the next 6 months
forecast_steps = 6
forecast = model.forecast(forecast_steps)

# 4. Calculate Prediction Intervals (The Senior-level part)
# We calculate the standard deviation of the residuals to build the 90% confidence interval
residuals = model.resid
std_dev = np.std(residuals)
z_score = stats.norm.ppf(0.95) # 90% confidence interval (5% on each tail)

# Create the upper and lower bounds
lower_bound = forecast - (z_score * std_dev)
upper_bound = forecast + (z_score * std_dev)

# 5. Combine into a clean DataFrame for the business
forecast_df = pd.DataFrame({
    'Forecasted_Loss': forecast,
    'Lower_Bound_90': lower_bound,
    'Upper_Bound_90': upper_bound
})

print("Forecasted Expected Loss (Next 6 Months):")
print(forecast_df)

# 6. Plotting the results (Visual proof for the README)
plt.figure(figsize=(10, 6))
plt.plot(df.index, df['expected_loss'], label='Historical Expected Loss', color='blue')
plt.plot(forecast_df.index, forecast_df['Forecasted_Loss'], label='Forecast', color='red', linestyle='--')
plt.fill_between(
    forecast_df.index, 
    forecast_df['Lower_Bound_90'], 
    forecast_df['Upper_Bound_90'], 
    color='pink', alpha=0.3, label='90% Confidence Interval'
)
plt.title('Expected Loss Forecast with Prediction Intervals')
plt.xlabel('Date')
plt.ylabel('Expected Loss ($)')
plt.legend()
plt.grid(True)
plt.show()
